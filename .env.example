# Copy to .env and adjust. Never commit the real .env (it is git-ignored).
# The backend reads ./.env (repo root) and ./backend/.env; real environment variables take precedence.

# ───────────────────────── Backend ─────────────────────────
# development | test | production. production refuses unsafe settings at startup (http URL, insecure cookies,
# missing APP_API_TOKEN, outbox mail) instead of silently running with them.
APP_ENV=development
LOG_LEVEL=INFO
# PostgreSQL with the pgvector extension (docker compose overrides this for the backend container).
# No Docker? `python backend/scripts/dev_db.py` starts an embedded Postgres+pgvector and prints a URL.
# SQLite also works for quick experiments (in-process vector search): sqlite:///./data/dev.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/course_assistant
MAX_UPLOAD_MB=25
# UPLOAD_DIR=./data/uploads          # default: backend/data/uploads

# ───────────────────────── Accounts, sessions & CSRF ─────────────────────────
# Where people open the web app (scheme://host[:port]). It is the trusted Origin for state-changing requests
# and the base of password-reset links. Production: https://your.domain
APP_PUBLIC_URL=http://localhost:3000
# Shared secret between the Next.js proxy and the API; the browser never sees it. Required in production
# (≥ 32 random characters):  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_TOKEN=
# Session cookie: HttpOnly, SameSite=Lax, Path=/, host-only. Behind HTTPS set SESSION_COOKIE_SECURE=true and
# prefer the __Host- prefix (__Host-aica_session / __Host-aica_csrf); the frontend must use the same names.
SESSION_COOKIE_NAME=aica_session
CSRF_COOKIE_NAME=aica_csrf
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Absolute lifetime of a sign-in without / with "Remember me", and the idle timeout (seconds).
SESSION_TTL_SECONDS=43200
SESSION_REMEMBER_TTL_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=604800
REGISTRATION_ENABLED=true
# Minimum 8 characters; NIST SP 800-63B recommends 15 when the password is the only sign-in factor.
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_RESET_TTL_SECONDS=1800
# Extra origins allowed to send state-changing requests (APP_PUBLIC_URL and CORS_ORIGINS always are).
CSRF_TRUSTED_ORIGINS=
# Only for browser apps on *other* origins calling the API directly (exact origins, never *). The bundled
# frontend is same-origin through its proxy and needs nothing here.
CORS_ORIGINS=
# Peers whose X-Forwarded-For is believed (IPs/CIDRs). Requests carrying APP_API_TOKEN are trusted anyway.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Rate limits, "<requests>/<seconds>" fixed windows stored in the database (shared by all API processes).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_IP=20/300
RATE_LIMIT_LOGIN_ACCOUNT=10/900
RATE_LIMIT_REGISTER_IP=10/3600
RATE_LIMIT_FORGOT_IP=10/3600
RATE_LIMIT_FORGOT_ACCOUNT=3/3600
RATE_LIMIT_RESET_IP=20/3600

# ───────────────────────── Mail (password reset) ─────────────────────────
# outbox (development: .eml files in MAIL_OUTBOX_DIR) | smtp (production) | disabled (reset switched off → 503)
MAIL_BACKEND=outbox
# MAIL_OUTBOX_DIR=./data/outbox      # default: backend/data/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AI Course Assistant <no-reply@example.com>
# STARTTLS on port 587, or SMTP_SSL=true (implicit TLS, usually port 465) — not both.
SMTP_STARTTLS=true
SMTP_SSL=false

# ───────────────────────── LLM ─────────────────────────────
# auto → anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY + OPENAI_MODEL are set,
#        else the offline (extractive, no-key) generator.
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (leave blank for models without effort support, e.g. Haiku)
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback to Anthropic's recommended model.
ANTHROPIC_FALLBACKS=true

# Any OpenAI-compatible endpoint: OpenAI, DeepSeek, Qwen/DashScope, Moonshot, Ollama, vLLM, LM Studio…
#   DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1   OPENAI_MODEL=deepseek-chat
#   Ollama:   OPENAI_BASE_URL=http://localhost:11434/v1     OPENAI_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

LLM_TIMEOUT_SECONDS=120

# ───────────────────────── Embeddings ──────────────────────
# fastembed (local ONNX, free, default) | openai (OpenAI-compatible /embeddings) | hash (tests only)
EMBEDDING_PROVIDER=fastembed
# English: BAAI/bge-small-en-v1.5 · Chinese+English: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# OpenAI: text-embedding-3-small (shortened to EMBEDDING_DIM automatically)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model's output size. Changing it requires a fresh database (the vector column is typed).
EMBEDDING_DIM=384

# ───────────────────────── Retrieval ───────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6

# ───────────────────────── Upload limits ───────────────────
# Office files are zip archives; limits protect against oversized or malicious uploads.
# MAX_PAGES=500
# MAX_DOCUMENT_CHARS=2000000
# MAX_UNZIPPED_MB=200

# ───────────────────────── Frontend ────────────────────────
# The browser talks to the Next.js server, which proxies /api/* to BACKEND_URL (runtime setting).
# Put these in frontend/.env.local for `npm run dev`; docker compose sets them for you (APP_API_TOKEN and the
# cookie names above are passed through).
# BACKEND_URL=http://127.0.0.1:8000
# Reverse proxies in front of Next.js that append to X-Forwarded-For (1 behind nginx/Caddy, 0 if exposed directly).
TRUSTED_PROXY_COUNT=0
