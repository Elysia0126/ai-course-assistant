# Copy to .env and adjust. Never commit the real .env (it is git-ignored).
# The backend reads ./.env (repo root) and ./backend/.env; real environment variables take precedence.

# ───────────────────────── Backend ─────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# PostgreSQL with the pgvector extension (docker compose overrides this for the backend container).
# No Docker? `python backend/scripts/dev_db.py` starts an embedded Postgres+pgvector and prints a URL.
# SQLite also works for quick experiments (in-process vector search): sqlite:///./data/dev.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/course_assistant
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
# UPLOAD_DIR=./data/uploads          # default: backend/data/uploads

# ───────────────────────── LLM ─────────────────────────────
# auto → anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY + OPENAI_MODEL are set,
#        else the offline (extractive, no-key) generator.
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (leave blank for models without effort support, e.g. Haiku)
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback to Anthropic's recommended model.
ANTHROPIC_FALLBACKS=true

# Any OpenAI-compatible endpoint: OpenAI, DeepSeek, Qwen/DashScope, Moonshot, Ollama, vLLM, LM Studio…
#   DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1   OPENAI_MODEL=deepseek-chat
#   Ollama:   OPENAI_BASE_URL=http://localhost:11434/v1     OPENAI_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

LLM_TIMEOUT_SECONDS=120

# ───────────────────────── Embeddings ──────────────────────
# fastembed (local ONNX, free, default) | openai (OpenAI-compatible /embeddings) | hash (tests only)
EMBEDDING_PROVIDER=fastembed
# English: BAAI/bge-small-en-v1.5 · Chinese+English: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# OpenAI: text-embedding-3-small (shortened to EMBEDDING_DIM automatically)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model's output size. Changing it requires a fresh database (the vector column is typed).
EMBEDDING_DIM=384

# ───────────────────────── Retrieval ───────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6

# ───────────────────────── Frontend ────────────────────────
# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
