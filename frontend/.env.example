# Server-side only (read by the Next.js /api proxy at runtime — never sent to the browser).
BACKEND_URL=http://127.0.0.1:8000
# Must match APP_API_TOKEN on the backend if you set one there.
APP_API_TOKEN=

# Optional: call a backend directly from the browser instead of through the proxy (requires CORS_ORIGINS
# on the backend). Leave unset for the default same-origin setup.
# NEXT_PUBLIC_API_URL=http://localhost:8000
