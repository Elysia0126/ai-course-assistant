# Server-side only: read at runtime by the /api proxy and the session check. Nothing here is NEXT_PUBLIC_*,
# so none of it reaches the browser. (Copy to .env.local for `npm run dev`; docker compose sets these.)
BACKEND_URL=http://127.0.0.1:8000
# Must equal APP_API_TOKEN on the backend (required in production; proves requests came through this server).
APP_API_TOKEN=
# Must match the backend's names if you change them (e.g. __Host-aica_session behind HTTPS).
SESSION_COOKIE_NAME=aica_session
CSRF_COOKIE_NAME=aica_csrf
# Reverse proxies in front of Next.js that append to X-Forwarded-For (1 for nginx/Caddy). 0 = reached directly.
TRUSTED_PROXY_COUNT=0
